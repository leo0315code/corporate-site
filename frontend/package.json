{
  "name": "corporate-site-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "通用企业官网前端（Vite + React 18 + React Router v6 + Tailwind CSS）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:seo": "npm run build && npm run prerender",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.3.5"
  }
}
