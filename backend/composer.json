{
    "name": "topthink/think",
    "description": "通用企业官网后端（ThinkPHP 8 + MySQL 8）",
    "keywords": [
        "framework",
        "thinkphp",
        "orm"
    ],
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.0.0",
        "topthink/framework": "^8.0",
        "topthink/think-orm": "^3.0"
    },
    "require-dev": {
        "symfony/var-dumper": "^4.2",
        "topthink/think-trace": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app"
        },
        "files": [
            "app/common.php"
        ],
        "classmap": [
            "extend"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "allow-plugins": {
            "topthink/think-installer": true
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php think service:discover",
            "@php think vendor:publish"
        ]
    },
    "extra": {
        "think-path": "vendor/topthink/framework"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
