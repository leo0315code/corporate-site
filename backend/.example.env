# 环境变量示例文件
# 使用方式：复制为 .env 后按需修改（.env 不入库）
#   cp .example.env .env

APP_DEBUG = true
APP_TRACE = false

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai

[DATABASE]
# 数据库类型（mysql / sqlite 备选）
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = corporate_site
USERNAME = root
PASSWORD = root
HOSTPORT = 3306
CHARSET = utf8mb4
DEBUG = true

[LANG]
default_lang = zh-cn

[CMS]
# 后台入口路径前缀（前端 VITE_CMS_PATH 与后端须一致）。
# - 建议包含随机字符段（≥6 位），避免被批量扫描，例如 /manage-x7k2；
# - 留空（或注释掉）= 后台关闭：后端不注册任何管理 API，
#   且该前缀下请求返回 HTTP 404，绝不在默认路径暴露后台；
# - 归一化后以 '/' 开头、无尾斜杠。
PATH = /manage-x7k2

# 操作日志保留天数（清理命令 oplog:clean 默认使用；默认 180 天）
OPLOG_RETAIN_DAYS = 180

# 留言接口限流：同一 IP 在 WINDOW 秒内最多 MAX 次提交（超限返回 1008 / HTTP 429）
MESSAGE_RATE_MAX = 5
MESSAGE_RATE_WINDOW = 600

# 跨域白名单（逗号分隔；同域部署可留空）。未命中来源不下发 CORS 头。
# CORS_ALLOW_ORIGINS = https://www.example.com,https://example.com
