# ============================================================
# 通用企业官网 · 根 .gitignore
# 说明：忽略依赖、构建产物、本地环境变量与系统/IDE 文件。
# 注意：backend/.example.env 为环境变量模板，必须保留在仓库中。
# ============================================================

# ---------- 前端（frontend/） ----------
node_modules/
dist/
.vite/
*.local
frontend/.env.local
frontend/.env.*.local

# ---------- 后端（backend/） ----------
backend/vendor/
backend/runtime/
# 实际环境变量不入库（保留 backend/.example.env 模板）
backend/.env
# 后台用户上传的图片（运行时产物，不入库；保留目录结构与安全加固文件）
backend/public/uploads/**
!backend/public/uploads/.htaccess
!backend/public/uploads/.gitkeep

# ---------- 依赖锁文件缓存 / 构建缓存 ----------
.npm/
.eslintcache

# ---------- 日志 ----------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
Desktop.ini

# ---------- IDE / 编辑器 ----------
.idea/
*.iml
*.swp
*.swo
*~
# .vscode 仅忽略个性化配置，保留团队共享的 settings/recommendations
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# ---------- 其他 ----------
# 本地数据库文件（SQLite 备选方案）
*.sqlite
*.sqlite3
backend/database/*.db

# ---------- WorkBuddy ----------
# 本地工作记忆/会话数据，不入库
.workbuddy/
